{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "social-automation-back",
  "main": "cloudflare_entry.py",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-automation",
      "database_id": "db352875-8c9f-4673-a4b1-cd5b51bb2539",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://sa-neuro-c.web.app",
    "PUBLIC_BACKEND_URL": "https://social-automation-back.contentfactory010.workers.dev",
    "INSTAGRAM_REDIRECT_URI": "https://social-automation-back.contentfactory010.workers.dev/api/auth/instagram/callback",
    "INSTAGRAM_SCOPES": "instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages",
    "INSTAGRAM_WEBHOOK_FIELDS": "comments,messages",
    "COOKIE_SECURE": "true",
    "COOKIE_SAMESITE": "none"
  }
}
